# Copy to .env.local for local development. On Vercel these are injected by the Supabase integration.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Legacy JWT anon key, used as a fallback when the publishable key is not set
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server only. Used for account deletion.
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Server only. Used by scripts/migrate.mjs to apply supabase/migrations during the build.
POSTGRES_URL_NON_POOLING=""
# Optional. Public origin used in auth emails when the request origin is unavailable.
NEXT_PUBLIC_SITE_URL=""
# Server only. A long random string; Vercel sends it with the nightly file clean-up (api/cron/files),
# which production refuses to run without it.
CRON_SECRET=""
