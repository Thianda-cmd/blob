<?xml version="1.0" encoding="utf-8"?>
<!-- The "Next up" widget (NextWidget.kt): small (2×2, also 2×1 and wider); it wakes itself when
     what it shows changes, and every half hour besides. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_next_description"
    android:initialLayout="@layout/widget_next"
    android:minWidth="110dp"
    android:minHeight="80dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:previewLayout="@layout/widget_next_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
