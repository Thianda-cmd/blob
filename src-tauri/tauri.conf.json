{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Blob",
  "mainBinaryName": "blob",
  "version": "0.4.0",
  "identifier": "org.bojes.blob",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://blob.bojes.org",
      "capabilities": [
        "start-page",
        "site"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Blob",
    "homepage": "https://blob.bojes.org",
    "category": "Education",
    "shortDescription": "Notes, learning and more with Blob",
    "longDescription": "Blob is a calm place for school: notes, projects, a CV builder and a learning centre with maths, biology and chemistry, together with Blob, the purple mascot.",
    "fileAssociations": [
      {
        "ext": [
          "blob"
        ],
        "name": "Blob file",
        "description": "Blob notes",
        "mimeType": "application/vnd.blob+json",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "org.bojes.blob.file",
          "conformsTo": [
            "public.json",
            "public.data"
          ]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "section": "education",
        "files": {
          "/usr/share/mime/packages/org.bojes.blob.xml": "linux/org.bojes.blob.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/org.bojes.blob.xml": "linux/org.bojes.blob.xml"
        }
      }
    },
    "android": {
      "minSdkVersion": 26,
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "org.bojes.blob"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "org.bojes.blob"
          ],
          "appLink": false
        }
      ]
    }
  }
}
